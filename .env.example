# JurisGlobal · variables de entorno. Copiar a .env y rellenar (nunca versionar .env).
# Generar secretos con:  openssl rand -hex 32
# Las credenciales de Meta, Gemini y SMTP pueden quedar vacías en desarrollo: el módulo que las
# use falla de forma explícita (fail-closed) y el resto de la API funciona.

# ── App ──
NODE_ENV=development
APP_TIMEZONE=America/Bogota
# URL pública (dominio de pruebas por ahora; cambiar al definitivo sin tocar código)
PUBLIC_BASE_URL=http://localhost:8088
# Orígenes extra para CORS (coma). Vacío = solo mismo origen (nginx)
CORS_ORIGINS=
LOG_LEVEL=log

# ── PostgreSQL (BD nueva y propia) ── solo hex/alfanumérico: va dentro de DATABASE_URL
POSTGRES_USER=jg_admin
POSTGRES_PASSWORD=
POSTGRES_DB=jurisglobal

# ── Redis (colas, deduplicación) ──
REDIS_PASSWORD=

# ── Sesión del panel ──
# Firma de los JWT (mín. 32 caracteres). Cambiarlo cierra todas las sesiones.
JWT_SECRET=
JWT_EXPIRES_IN=12h
# true en producción (HTTPS detrás de Cloudflare)
COOKIE_SECURE=false
# 32 bytes en hex (64 caracteres): cifrado de secretos 2FA y seudónimo de teléfonos.
# NO cambiar una vez en uso (invalida los 2FA y la trazabilidad de bajas).
ENCRYPTION_KEY=

# ── Administrador inicial (lo usa solo el seed; se puede borrar después) ──
ADMIN_EMAIL=
ADMIN_NAME=Administrador
# Mín. 10 caracteres
ADMIN_PASSWORD=

# ── Gemini (API key nueva y exclusiva de JurisGlobal) ──
GOOGLE_GENERATIVE_AI_API_KEY=
# Opcionales: modelo principal, respaldos (coma) y tiempo máximo por intento (ms)
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GEMINI_TIMEOUT_MS=

# ── WhatsApp Cloud API (Meta) ──
WHATSAPP_GRAPH_VERSION=v22.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
# Token permanente de usuario del sistema
WHATSAPP_ACCESS_TOKEN=
# Verifica la firma x-hub-signature-256 de los webhooks
META_APP_SECRET=
# Token del GET de verificación del webhook (se pega en la configuración de la app de Meta).
# URL de devolución a registrar en Meta: https://<dominio>/webhooks/whatsapp (alias: /meta/webhook)
WHATSAPP_VERIFY_TOKEN=

# ── Correo: aviso de lead nuevo / recontacto · Gmail con contraseña de aplicación ──
# Vacío en desarrollo = la API arranca con una advertencia y no envía correos.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
LEAD_NOTIFICATION_EMAIL=

# ── Formulario público: envíos por minuto e IP a POST /api/leads ──
LEADS_RATE_LIMIT=5

# ── Web pública: datos de contacto (PROVISIONALES: valores de relleno, ESP §2 y §13.3) ──
# Next los incrusta al compilar la imagen web: cambiarlos exige `./jg up` (rebuild).
# Número de WhatsApp de JurisGlobal (solo dígitos, con indicativo 57). PROVISIONAL
NEXT_PUBLIC_WHATSAPP_NUMBER=573001234567
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hola, JurisGlobal. Quiero dejar mis datos para que un asesor me contacte.
# PROVISIONAL (relleno de las piezas gráficas)
NEXT_PUBLIC_CONTACT_PHONE=300 123 4567
# PROVISIONAL
NEXT_PUBLIC_CONTACT_EMAIL=contacto@jurisglobal.test
# PROVISIONAL: razón social y NIT pendientes (ESP §13.1)
NEXT_PUBLIC_NIT_INFO=NIT en trámite

# ── nginx ──
NGINX_BIND=127.0.0.1
NGINX_HOST_PORT=8088
